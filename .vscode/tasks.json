{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Vite dev server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/client" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend: Django server",
      "type": "shell",
      "command": "py",
      "args": ["manage.py", "runserver"],
      "options": { "cwd": "${workspaceFolder}/server" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: production build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": { "cwd": "${workspaceFolder}/client" },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
