DATABASE_ENGINE=postgresql
POSTGRES_DB=realbusiness
POSTGRES_USER=realbusiness
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# For Render + Supabase, set DATABASE_URL to the Supabase session pooler URL
# (including ?sslmode=require) in Render's environment settings. Do not commit it.
ALLOWED_HOSTS=.onrender.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ssekanasystems.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ssekanasystems.vercel.app
